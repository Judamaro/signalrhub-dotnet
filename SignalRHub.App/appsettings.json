{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Realtime": {
    "HubPath": "/hubs/notifications",
    "ClientIdClaim": "sub"
  },
  "Metrics": {
    "Port": 9464,
    "Path": "/metrics"
  },
  "Jwt": {
    "Issuer": "signalrhub",
    "Audience": "signalrhub-clients",
    "SigningKey": ""
  },
  "ApiKeys": {
    "HeaderName": "X-Api-Key",
    "Keys": []
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
